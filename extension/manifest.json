{
  "manifest_version": 3,
  "name": "AutoApply Capture",
  "version": "0.1.0",
  "description": "User-initiated LinkedIn job capture for AutoApply.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/jobs/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Capture LinkedIn Job",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
